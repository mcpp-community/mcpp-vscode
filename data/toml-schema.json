        {
          "key": "cflags",
          "type": "array"
        },
        {
          "key": "cxx_runtime",
          "type": "enum",
          "values": [
            "self-contained",
            "toolchain-coupled",
            "host-coupled"
          ],
          "default": "self-contained",
          "note": "docs/20; static_stdlib is the old spelling"
        },
        {
          "key": "cxxflags",
          "type": "array"
        },
        {
          "key": "default-profile",
          "type": "string",
          "note": "profile name, e.g. \"release\""
        },
        {
          "key": "defines",
          "type": "array"
        },
        {
          "key": "dependency_linkage",
