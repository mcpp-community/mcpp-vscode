            "static",
            "shared"
          ],
          "default": "static"
        },
        {
          "key": "dialect_cxxflags",
          "type": "array",
          "since": "2026.9.28.1"
        },
        {
          "key": "flags",
          "type": "array",
          "note": "array of { glob, cflags, cxxflags, asmflags, defines } tables",
          "unmodelled": true
        },
        {
          "key": "include_dirs",
          "type": "array"
        },
        {
          "key": "include_dirs_after",
          "type": "array"
        },
        {
          "key": "ios_deployment_target",
          "type": "string"
        },
        {
          "key": "jobs",
          "type": "enum",
          "values": [
            "auto"
